{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indicator-store",
  "main": "worker.js",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indicator-store-db",
      "database_id": "ff3ced91-b71d-4a4a-814e-6a727eae9b5d"
    }
  ]
}